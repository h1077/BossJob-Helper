\NeedsTeXFormat{LaTeX2e}[1994/06/01]
\ProvidesPackage{zh_CN-Adobefonts_external}[2026/06/09 portable CJK font package]

\RequirePackage{fontspec}
\RequirePackage{xeCJK}

\ifdefined\XeTeXgenerateactualtext
  \XeTeXgenerateactualtext=1
\fi

\defaultfontfeatures{Mapping=tex-text}

\newcommand*{\TailorCVSetMacCJKFonts}{%
  \setCJKmainfont[
    BoldFont=Heiti SC,
    ItalicFont=Songti SC,
    SmallCapsFont=Heiti SC
  ]{Songti SC}%
  \setCJKsansfont{Heiti SC}%
  \setCJKmonofont{Songti SC}%
  \setCJKfamilyfont{zhsong}{Songti SC}%
  \setCJKfamilyfont{zhhei}{Heiti SC}%
  \setCJKfamilyfont{zhfs}{Songti SC}%
  \setCJKfamilyfont{zhkai}{Songti SC}%
  \setCJKfamilyfont{zhsection}[AutoFakeBold=3]{Heiti SC}%
}

\newcommand*{\TailorCVSetWindowsCJKFonts}{%
  \setCJKmainfont[
    BoldFont=SimHei,
    ItalicFont=KaiTi,
    SmallCapsFont=SimHei
  ]{SimSun}%
  \setCJKsansfont{SimHei}%
  \setCJKmonofont{FangSong}%
  \setCJKfamilyfont{zhsong}{SimSun}%
  \setCJKfamilyfont{zhhei}{SimHei}%
  \setCJKfamilyfont{zhfs}{FangSong}%
  \setCJKfamilyfont{zhkai}{KaiTi}%
  \setCJKfamilyfont{zhsection}[AutoFakeBold=3]{SimHei}%
}

\newcommand*{\TailorCVSetFandolCJKFonts}{%
  \setCJKmainfont[
    BoldFont=FandolHei-Regular.otf,
    ItalicFont=FandolKai-Regular.otf,
    SmallCapsFont=FandolHei-Regular.otf
  ]{FandolSong-Regular.otf}%
  \setCJKsansfont{FandolHei-Regular.otf}%
  \setCJKmonofont{FandolFang-Regular.otf}%
  \setCJKfamilyfont{zhsong}{FandolSong-Regular.otf}%
  \setCJKfamilyfont{zhhei}{FandolHei-Regular.otf}%
  \setCJKfamilyfont{zhfs}{FandolFang-Regular.otf}%
  \setCJKfamilyfont{zhkai}{FandolKai-Regular.otf}%
  \setCJKfamilyfont{zhsection}[AutoFakeBold=3]{FandolHei-Regular.otf}%
}

\IfFontExistsTF{Songti SC}{%
  \TailorCVSetMacCJKFonts
}{%
  \IfFontExistsTF{FandolSong-Regular.otf}{%
    \TailorCVSetFandolCJKFonts
  }{%
    \TailorCVSetWindowsCJKFonts
  }%
}

\newcommand*{\songti}{\CJKfamily{zhsong}}
\newcommand*{\heiti}{\CJKfamily{zhhei}}
\newcommand*{\kaishu}{\CJKfamily{zhkai}}
\newcommand*{\fangsong}{\CJKfamily{zhfs}}
\newcommand*{\sectionheiti}{\CJKfamily{zhsection}}

\endinput
