{
  "manifest_version": 3,
  "name": "Boss海投助手",
  "version": "1.1.6",
  "description": "BOSS直聘智能投递助手：自动搜索、AI匹配、定制招呼语、跨页面自动投递",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "BOSS自动投递" },
  "side_panel": { "default_path": "src/sidepanel.html" },
  "permissions": ["storage", "tabs", "scripting", "sidePanel"],
  "host_permissions": [
    "http://localhost:5001/*",
    "*://*.zhipin.com/*",
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "https://api.siliconflow.cn/*",
    "https://ark.cn-beijing.volces.com/*",
    "https://spark-api-open.xf-yun.com/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.zhipin.com/web/geek/job*"],
      "js": ["src/selectors.js", "src/content-search.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.zhipin.com/web/geek/chat*"],
      "js": ["src/selectors.js", "src/conversation-strategy.js", "src/feedback-events.js", "src/content-chat.js"],
      "run_at": "document_idle"
    }
  ]
}
